<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondo_morado"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_texto_borde"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="Sistema de Soporte Técnico"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- ================= PANEL 1: MENÚ DE SELECCIÓN DE ROL ================= -->
        <LinearLayout
            android:id="@+id/panelMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_texto_borde"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="¿Cómo deseas ingresar?"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIrAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_btn_admin"
                android:padding="14dp"
                android:text="Ingresar como Administrador"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnIrUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_usuario"
                android:padding="14dp"
                android:text="Entrar como Usuario (Crear / Ver Caso)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- ================= PANEL 2: LOGIN DE ADMINISTRADOR ================= -->
        <LinearLayout
            android:id="@+id/panelAdminLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtrasLogin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_texto_borde"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_texto_borde"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="Acceso Administrador"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_morada"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="Login Administrador"
                        android:textColor="#E9D5FF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtAdminUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Nombre de Administrador"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <EditText
                        android:id="@+id/txtAdminPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnLoginAdmin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_admin"
                            android:text="Entrar"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnVolverMenu1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_usuario"
                            android:text="Volver"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ================= PANEL 3: DASHBOARD DEL ADMINISTRADOR ================= -->
        <LinearLayout
            android:id="@+id/panelAdminDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtrasDashboard"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_texto_borde"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/lblSaludoAdmin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_texto_borde"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="Bienvenido"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_texto_borde"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Casos Asignados"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/listViewAdminTickets"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_morada"
                android:divider="#9333EA"
                android:dividerHeight="1dp"
                android:padding="8dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCerrarSesionAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_cerrar"
                android:padding="12dp"
                android:text="Cerrar Sesión"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- ================= PANEL 4: FORMULARIO Y CONSULTA DE USUARIO ================= -->
        <LinearLayout
            android:id="@+id/panelUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtrasUsuario"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_texto_borde"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_texto_borde"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="Portal de Usuario"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_morada"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Registrar Nuevo Caso"
                        android:textColor="#E9D5FF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tipo de Solicitud:"
                        android:textColor="#F3E8FF"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgTipoSolicitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbIncidente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#D8B4FE"
                            android:checked="true"
                            android:text="Incidente (INC)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rbOrdenTrabajo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#D8B4FE"
                            android:text="Orden de Trabajo (WO)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rbGarantia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#D8B4FE"
                            android:text="Garantía (Falla de fábrica / sin golpe)"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>

                    <EditText
                        android:id="@+id/txtTituloCaso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Título del Caso (Ej: Falla de red en el área)"
                        android:inputType="textCapSentences"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <EditText
                        android:id="@+id/txtNombreUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Nombre de Usuario (Solo texto)"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <EditText
                        android:id="@+id/txtCorreoCorporativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Correo (@compensar.com o @consorciosalud.com)"
                        android:inputType="textEmailAddress"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <EditText
                        android:id="@+id/txtDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="ID Corporativo / Documento (Máx. 10 dígitos)"
                        android:inputType="number"
                        android:maxLength="10"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <EditText
                        android:id="@+id/txtPlacaEquipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Placa del Equipo (Máx. 13 caracteres)"
                        android:inputType="text"
                        android:maxLength="13"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <LinearLayout
                        android:id="@+id/layoutCamposGarantia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#802E1065"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="6dp"
                            android:text="Datos del Equipo en Garantía:"
                            android:textColor="#E9D5FF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marca del Equipo:"
                            android:textColor="#F3E8FF"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/spinnerMarca"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input_morado"
                            android:popupBackground="#1E0E38"
                            app:popupTheme="@style/SpinnerPopupMorado" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Formato del Equipo:"
                            android:textColor="#F3E8FF"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/spinnerTipoEquipo"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input_morado"
                            android:popupBackground="#1E0E38"
                            app:popupTheme="@style/SpinnerPopupMorado" />

                        <EditText
                            android:id="@+id/txtSerialEquipo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_morado"
                            android:hint="Serial del Equipo (S/N)"
                            android:inputType="textCapCharacters"
                            android:padding="12dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#C4B5FD" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/txtDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_morado"
                        android:gravity="top|start"
                        android:hint="Descripción de los hechos / falla"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <Button
                        android:id="@+id/btnCrearCaso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_usuario"
                        android:text="Registrar Caso"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_morada"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Consultar Mis Casos"
                        android:textColor="#E9D5FF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtBuscarDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_morado"
                        android:hint="Ingresa tu ID Corporativo / Documento"
                        android:inputType="number"
                        android:maxLength="10"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#C4B5FD" />

                    <Button
                        android:id="@+id/btnConsultarCasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_btn_admin"
                        android:text="Buscar Casos"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/lblResultadoConsulta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:textColor="#F3E8FF"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutUserTicketsLista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>